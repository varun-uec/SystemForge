# Fast checks only. A commit happens dozens of times a day, so anything slow
# here gets bypassed with --no-verify and then protects nothing.
#
# lint-staged formats just the files you staged, so a commit can never
# introduce a formatting failure in CI.
if command -v bunx >/dev/null 2>&1; then
  bunx lint-staged
else
  npx lint-staged
fi
