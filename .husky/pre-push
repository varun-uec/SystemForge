# The full gate, matching CI exactly. Push is rare enough to afford a few
# seconds, and catching a failure here is far cheaper than a red build on main.
#
# Everything below mirrors .github/workflows/ci.yml. If you change one, change
# the other.

CMD="npm run"
if command -v bun >/dev/null 2>&1; then
  CMD="bun run"
fi

echo "Typechecking..."
$CMD typecheck || {
  echo ""
  echo "Typecheck failed. Fix the errors above, or push with --no-verify if"
  echo "you genuinely mean to push a broken build."
  exit 1
}

echo "Linting..."
$CMD lint || exit 1

echo "Checking formatting..."
$CMD format:check || {
  echo ""
  echo "Formatting is off. Run: $CMD format"
  exit 1
}

echo "Running tests..."
$CMD test || exit 1

echo "All checks passed."
